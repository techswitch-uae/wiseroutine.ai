{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wise Routine",
  "version": "0.1.0",
  "identifier": "ai.wiseroutine.app",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:41000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "Wise Routine",
        "width": 1180,
        "height": 820
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/techswitch-uae/wiseroutine.ai/releases/latest/download/latest.json"
      ]
    }
  }
}
