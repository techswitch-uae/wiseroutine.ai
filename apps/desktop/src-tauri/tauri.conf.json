{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wise Routine",
  "version": "0.1.0",
  "identifier": "ai.wiseroutine.app",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:41000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../.output/public"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Wise Routine",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1180,
        "height": 820,
        "backgroundColor": "#eee7db"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.wiseroutine.ai https://api-dev.wiseroutine.ai http://localhost:8787",
        "img-src": "'self' data: blob: https:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "frame-src": "https://open.spotify.com addon: http://addon.localhost",
        "media-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/techswitch-uae/wiseroutine.ai/releases/latest/download/latest.json"
      ]
    }
  }
}
