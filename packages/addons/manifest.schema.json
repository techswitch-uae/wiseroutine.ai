{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiseroutine.ai/schemas/addon-manifest.json",
  "title": "Wise Routine addon manifest",
  "type": "object",
  "required": ["id", "name", "version", "description", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 64,
      "description": "Lowercase, dot or hyphen separated. The `wiseroutine.` prefix is reserved."
    },
    "apiVersion": { "type": "integer", "minimum": 1, "default": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 500 },
    "version": { "type": "string", "minLength": 1, "maxLength": 500 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    },
    "settings": {
      "type": "array",
      "maxItems": 20,
      "description": "Settings for the addon as a whole. The only place a `secret` field may appear.",
      "items": { "$ref": "#/$defs/field" }
    },
    "widgets": { "type": "array", "items": { "$ref": "#/$defs/contribution" } },
    "quickAdd": {
      "type": "array",
      "items": { "$ref": "#/$defs/contribution" }
    },
    "activityTypes": {
      "type": "array",
      "items": { "$ref": "#/$defs/activityType" }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 64
    },
    "settingKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 64
    },
    "origin": {
      "type": "string",
      "pattern": "^https://[^/*\\s;\"]+$",
      "description": "A plain https origin: scheme and host, nothing else."
    },
    "origins": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/origin" }
    },
    "capability": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "scope"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "read:schedule" },
            "scope": { "enum": ["today"] }
          }
        },
        {
          "type": "object",
          "required": ["kind", "origins"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "net:fetch" },
            "origins": { "$ref": "#/$defs/origins" },
            "auth": {
              "type": "object",
              "required": ["secret", "header"],
              "additionalProperties": false,
              "properties": {
                "secret": { "$ref": "#/$defs/settingKey" },
                "header": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9-]{1,64}$"
                },
                "prefix": { "type": "string", "maxLength": 32 }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "origins"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["ui:embed", "open:external"] },
            "origins": { "$ref": "#/$defs/origins" }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "write:own",
                "ui:widget",
                "ui:session",
                "background:wake",
                "notify",
                "read:todos",
                "write:todos"
              ]
            }
          }
        }
      ]
    },
    "contribution": {
      "type": "object",
      "required": ["key", "name"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "fieldBase": {
      "type": "object",
      "required": ["key", "label", "type"],
      "properties": {
        "key": { "$ref": "#/$defs/settingKey" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "help": { "type": "string", "maxLength": 200 },
        "showWhen": {
          "type": "object",
          "required": ["key", "equals"],
          "additionalProperties": false,
          "properties": {
            "key": { "$ref": "#/$defs/settingKey" },
            "equals": { "type": ["string", "number", "boolean"] }
          }
        }
      }
    },
    "field": {
      "allOf": [
        { "$ref": "#/$defs/fieldBase" },
        {
          "oneOf": [
            {
              "properties": {
                "type": { "const": "select" },
                "default": { "type": "string" },
                "options": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 50,
                  "items": { "type": "string", "maxLength": 100 }
                }
              },
              "required": ["default", "options"]
            },
            {
              "properties": {
                "type": { "const": "number" },
                "default": { "type": "number" },
                "min": { "type": "number" },
                "max": { "type": "number" }
              },
              "required": ["default"]
            },
            {
              "properties": {
                "type": { "const": "text" },
                "default": { "type": "string" },
                "maxLength": { "type": "number" },
                "placeholder": { "type": "string", "maxLength": 100 }
              },
              "required": ["default"]
            },
            {
              "properties": {
                "type": { "const": "boolean" },
                "default": { "type": "boolean" }
              },
              "required": ["default"]
            },
            {
              "properties": {
                "type": { "const": "secret" },
                "placeholder": { "type": "string", "maxLength": 100 }
              }
            }
          ]
        }
      ]
    },
    "activityType": {
      "type": "object",
      "required": ["key", "name", "blurb", "defaults"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "blurb": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Finishes the sentence \"When this is on, ...\"."
        },
        "defaults": {
          "type": "object",
          "required": ["sessionMinutes", "startPolicy"],
          "additionalProperties": false,
          "properties": {
            "sessionMinutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 240
            },
            "startPolicy": { "enum": ["manual", "auto", "prompt"] }
          }
        },
        "ground": { "enum": ["page", "dim"] },
        "canvas": {
          "type": "object",
          "required": ["width", "height"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "number", "minimum": 200, "maximum": 560 },
            "height": { "type": "number", "minimum": 120, "maximum": 520 }
          }
        },
        "settings": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    }
  }
}
