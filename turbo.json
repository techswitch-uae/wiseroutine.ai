{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local", "scripts/**"],
  "envMode": "loose",
  "tasks": {
    "generate": {
      "inputs": [
        "prisma/**",
        "prisma.*.config.ts",
        "migrations/**",
        "scripts/embed-migrations.mjs"
      ],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "env": ["VITE_API_URL"],
      "dependsOn": ["^build", "test", "generate", "^generate"],
      "outputs": [
        "dist/**",
        ".output/**",
        "!.output/**/cache/**",
        "public/addons/**"
      ]
    },
    "test": { "dependsOn": ["^test", "generate", "^generate"] },
    "typecheck": { "dependsOn": ["^typecheck", "generate", "^generate"] },
    "dev": { "cache": false, "persistent": true },
    "clean": { "cache": false }
  }
}
