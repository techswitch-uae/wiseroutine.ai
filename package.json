{
  "name": "wiseroutine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "design": "pnpm --filter @wiseroutine/desktop dev:vite --port 41100 --open /design",
    "dev": "pnpm --filter @wiseroutine/desktop dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck test && biome check",
    "lint": "biome check",
    "fix": "biome check --write",
    "clean": "turbo run clean",
    "bundle": "pnpm --filter @wiseroutine/desktop bundle",
    "api": "pnpm --filter @wiseroutine/api dev",
    "wrangler": "pnpm --filter @wiseroutine/api exec wrangler"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "typescript": "^7.0.2",
    "turbo": "^2.6.2"
  }
}
