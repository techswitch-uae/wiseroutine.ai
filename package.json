{
  "name": "wiseroutine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "design": "pnpm --filter @wiseroutine/desktop dev:vite --port 41100 --open /design",
    "sim": "pnpm --filter @wiseroutine/desktop dev:vite --port 41100 --open /sim",
    "dev": "pnpm --filter @wiseroutine/desktop dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck test && biome check",
    "lint": "biome check",
    "fix": "biome check --write",
    "clean": "turbo run clean",
    "bundle": "pnpm --filter @wiseroutine/desktop bundle",
    "api": "pnpm --filter @wiseroutine/api dev",
    "wrangler": "pnpm --filter @wiseroutine/api exec wrangler",
    "release:preview": "pnpm dlx release-please release-pr --dry-run --repo-url=techswitch-uae/wiseroutine.ai --config-file=release-please-config.json --manifest-file=.release-please-manifest.json --token=$GITHUB_TOKEN",
    "db:migrate": "pnpm --filter @wiseroutine/db migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "typescript": "^7.0.2",
    "turbo": "^2.6.2"
  }
}
